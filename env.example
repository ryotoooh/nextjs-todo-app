# Database storage configuration
# Options: array, sqlite
# array: In-memory storage (default)
# sqlite: SQLite database storage

# Server-side environment variable
DATABASE_STORAGE=sqlite

# Client-side environment variable (for consistency)
NEXT_PUBLIC_DATABASE_STORAGE=sqlite

# Database URL configuration
# For SQLite: file path (e.g., ./data/todos.db)
# For MongoDB: connection string (e.g., mongodb://localhost:27017/todos)
# For PostgreSQL: connection string (e.g., postgresql://user:pass@localhost:5432/todos)
DATABASE_URL=./data/todos.db

# Client-side database URL (for consistency)
NEXT_PUBLIC_DATABASE_URL=./data/todos.db
