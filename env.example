# Database storage configuration
# Options: array, api, sqlite, local
# array: In-memory storage (default)
# api: External API storage
# sqlite/local: SQLite database storage

# Server-side environment variable
DATABASE_STORAGE=array

# Client-side environment variable (for consistency)
# Note: Client-side always uses API, but this can be used for configuration
NEXT_PUBLIC_DATABASE_STORAGE=array

# SQLite database configuration
# Path to SQLite database file (only used when DATABASE_STORAGE=sqlite)
SQLITE_DB_PATH=./data/todos.db

# API configuration (only used when DATABASE_STORAGE=api)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
